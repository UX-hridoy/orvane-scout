# Scout runs without any of these. A key only adds a live model for open questions.

# Free. Create a key at https://aistudio.google.com/apikey
# On Vercel, add it under Project > Settings > Environment Variables instead of in a file.
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional. Which Gemini model to use. Default: gemini-3.5-flash-lite
SCOUT_GEMINI_MODEL=

# Optional, paid. Vercel AI Gateway key and any model id from https://ai-gateway.vercel.sh/v1/models
AI_GATEWAY_API_KEY=
SCOUT_MODEL=anthropic/claude-sonnet-5.5

# Optional. Set to "off" to force the built-in layer even when a key is set.
SCOUT_LIVE=
